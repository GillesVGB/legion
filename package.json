{
  "name": "bakarov-future-rp-bot",
  "version": "2.6.1",
  "private": true,
  "description": "Nederlandstalige Discord-bot voor Bakarov in Future RP",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.js",
    "check": "node --env-file-if-exists=.env scripts/check.js",
    "test": "node --test",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "discord.js": "14.25.1"
  }
}
