{
  "name": "legion-future-rp-bot",
  "version": "1.6.0",
  "private": true,
  "description": "Nederlandstalige Discord-bot voor Legion in Future RP",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
