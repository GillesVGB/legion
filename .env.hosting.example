# Kopieer naar .env in de hoofdmap. Zet alleen daar je eigen bot-token.
DISCORD_TOKEN=VUL_HIER_JE_BOT_TOKEN_IN
CLIENT_ID=1556774794358169652
DATA_DIR=./data

# Bot-Hosting.net: SERVER_PORT=25237 selecteert automatisch het adres uit hosting.json.
# Bij een andere deployment kun je het eigen HTTPS-basisadres hieronder invullen.
# DASHBOARD_PUBLIC_URL=https://jouw-app.apps.bot-hosting.cloud
# Zonder vast adres gebruikt de bot de meegeleverde Cloudflare-client.
TRANSCRIPT_VIEWER_MODE=local
TRANSCRIPT_PORT=8793
CLOUDFLARED_PATH=./bin/cloudflared
CLOUDFLARED_PROTOCOL=auto
CLOUDFLARED_EDGE_IP_VERSION=4

# FPS.ms met weinig RAM. De bootstrap past dit toe vóór het laden van de bot.
NODE_OPTIONS=--max-old-space-size=48
GOMEMLIMIT=20MiB

EMBED_COLOR=#B91C1C
WARN_THRESHOLD=3
STARTING_COINS=1000
DAILY_COINS=250
MAX_BET=500
BLACKJACK_TIMEOUT_MINUTES=10
GAMES_MEMBERS_ONLY=false
