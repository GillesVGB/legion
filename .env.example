# Maak lokaal een .env met deze inhoud. Deel je bot-token nooit.
DISCORD_TOKEN=VUL_HIER_JE_BOT_TOKEN_IN
CLIENT_ID=1556774794358169652

# Guilds, rollen, categorieen, logkanaal en paneelkanaal: zie guilds.json.

# Vormgeving en grenzen
EMBED_COLOR=#B91C1C
WARN_THRESHOLD=3
STARTING_COINS=1000
DAILY_COINS=250
MAX_BET=500
BLACKJACK_TIMEOUT_MINUTES=10
# true = alleen leden met de MEMBER_ROLE_ID per guild mogen games gebruiken.
GAMES_MEMBERS_ONLY=false

# files = alleen TXT/HTML in Discord; local = neutrale webviewer via cloudflared.
# Installeer de officiële cloudflared-client en vul het pad in (of gebruik PATH).
TRANSCRIPT_VIEWER_MODE=local
TRANSCRIPT_PORT=8793
# Leeg = automatisch bin/cloudflared op Linux, bin/cloudflared.exe op Windows, of PATH.
CLOUDFLARED_PATH=
# Op Bot-Hosting port 25237 gebruikt de bot automatisch het HTTPS-adres uit hosting.json.
# Op een andere hosting kun je hier het eigen vaste HTTPS-basisadres invullen.
# DASHBOARD_PUBLIC_URL=https://jouw-app.apps.bot-hosting.cloud
CLOUDFLARED_PROTOCOL=auto
CLOUDFLARED_EDGE_IP_VERSION=4

# Alleen voor een zelf beheerde vaste HTTPS-viewer met remote upload-API.
TRANSCRIPT_SITE_URL=
TRANSCRIPT_SITE_TOKEN=
TRANSCRIPT_UPLOAD_SECRET=
